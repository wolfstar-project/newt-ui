{
  "$schema": "https://unpkg.com/@changesets/config/schema.json",
  "changelog": [
    "./generator.ts",
    {
      "repo": "wolfstar-project/newt-ui"
    }
  ],
  "commit": false,
  "format": "oxfmt",
  "fixed": [],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": ["docs", "www", "vue-www", "next-template", "nuxt-template"],
  "snapshot": {
    "useCalculatedVersion": true,
    "prereleaseTemplate": "{tag}-{datetime}"
  }
}
