{
  // No `baseUrl`: the repo overrides `typescript` with `typescript-native-bridge`,
  // whose checker removed it. `paths` alone resolves relative to this file.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/lib/registry": ["../vue/app/lib/registry"],
      "@/lib/registry/*": ["../vue/app/lib/registry/*"],
      "@/lib/utils": ["./src/lib/utils.ts"],
      "@/registry/*": ["../www/registry/*"],
      "@/components": ["./src/components"],
      "@/components/*": ["./src/components/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/stores/*": ["./src/stores/*"],
      "@/styles/*": ["./src/styles/*"],
      "@/lib/*": ["./src/lib/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "astro.config.ts",
    "../www/registry/**/*",
    "../vue/app/lib/registry/**/*"
  ],
  "exclude": ["dist", "node_modules"]
}
