{
  // No `baseUrl`: the repo overrides `typescript` with `typescript-native-bridge`,
  // whose checker removed it. `paths` alone resolves relative to this file.
  //
  // Blume reads these `paths` into the generated runtime's Vite aliases, which
  // is what lets the registry demos import `@/registry/...` unchanged from
  // inside `.blume/`. `.blume/.astro/types.d.ts` is where `blume check` writes
  // the `astro:*` and `blume:*` module types.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/lib/registry": ["../vue/registry"],
      "@/lib/registry/*": ["../vue/registry/*"],
      "~~/registry": ["../vue/registry"],
      "~~/registry/*": ["../vue/registry/*"],
      "@/lib/utils": ["./src/lib/utils.ts"],
      "@/registry/*": ["../www/registry/*"],
      "@/components": ["./src/components"],
      "@/components/*": ["./src/components/*"],
      "@/stores/*": ["./src/stores/*"],
      "@/lib/*": ["./src/lib/*"],
      "@newt-html/*": ["../../packages/cli/registry/html/*"]
    }
  },
  "include": [
    ".blume/.astro/types.d.ts",
    "src/**/*",
    "pages/**/*",
    "scripts/**/*",
    "blume.config.ts",
    "components.ts",
    "../www/registry/**/*",
    "../vue/registry/**/*"
  ],
  "exclude": ["dist", "node_modules"]
}
