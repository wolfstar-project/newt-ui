---
import { getCollection, render, type CollectionEntry } from "astro:content"

import Callout from "../../../components/mdx/Callout.astro"
import ComponentPreview from "../../../components/mdx/ComponentPreview.astro"
import PmTabs from "../../../components/mdx/PmTabs.astro"
import Steps from "../../../components/mdx/Steps.astro"
import Tabs from "../../../components/mdx/Tabs.astro"
import DocsPage from "../../../layouts/DocsPage.astro"

export async function getStaticPaths() {
  const entries = await getCollection("changelog")
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}

interface Props {
  readonly entry: CollectionEntry<"changelog">
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

const components = { Callout, ComponentPreview, PmTabs, Steps, Tabs }
---

<DocsPage
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
>
  <Content components={components} />
</DocsPage>
