---
import { getCollection, render, type CollectionEntry } from "astro:content"
import { Callout } from "@prosefly/astro-components"
import {
  PageAside,
  PageHeader,
  PageMeta,
  PageNavigation,
} from "@prosefly/astro-theme-lotus/components"
import { DocsContextLayout } from "@prosefly/astro-theme-lotus/layouts"
import { getDocsContext } from "@prosefly/astro-theme-lotus/navigation"

import ComponentPreview from "../../components/mdx/ComponentPreview.astro"
import FrameworkGrid from "../../components/mdx/FrameworkGrid.astro"
import Installation from "../../components/mdx/Installation.astro"
import PathTabs from "../../components/mdx/PathTabs.astro"
import PmTabs from "../../components/mdx/PmTabs.astro"
import PropsTable from "../../components/mdx/PropsTable.astro"
import Steps from "../../components/mdx/Steps.astro"
import Tabs from "../../components/mdx/Tabs.astro"
import TokensNote from "../../components/mdx/TokensNote.astro"
import Usage from "../../components/mdx/Usage.astro"
import { markdownPathFor, pathFor } from "../../lib/docs"
import { buildHead } from "../../lib/lotus-head"
import { DOCS_SECTION, pagination, sectionTitleFor } from "../../lib/lotus-nav"

/*
 * The docs page, on the theme's chrome.
 *
 * Lotus injects a route of its own for `/docs/[...slug]`; the patch removes it
 * and this one takes its place, for one reason that cannot be configured away:
 * the theme renders `<Content />` with no `components` prop, and every one of
 * the 107 files here writes `<ComponentPreview>` or `<Installation>` without
 * importing it. The rest of what this file does — the head tags, prev/next,
 * the copy-page menu — the theme either does not emit or does not expose.
 */
export async function getStaticPaths() {
  const entries = await getCollection("docs")
  return entries.map((entry) => ({
    // `index.mdx` is `/docs` itself; every other id is the path after it.
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }))
}

interface Props {
  readonly entry: CollectionEntry<"docs">
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

/*
 * Content files use these names without importing them, so a page stays prose
 * plus the two or three tags that make it a component page.
 */
const components = {
  Callout,
  ComponentPreview,
  FrameworkGrid,
  Installation,
  PathTabs,
  PmTabs,
  PropsTable,
  Steps,
  Tabs,
  TokensNote,
  Usage,
}

/*
 * A gate, not a menu. `PageHeader` renders the page-actions slot only when
 * this array is non-empty, and the slot is overridden with the site's own
 * copy-page menu, which builds its entries from the page's id — so the one
 * entry here is never read, it only says "yes, this page has actions".
 */
const PAGE_ACTIONS = [{ type: "copy-page" as const }]

const markdownPath = markdownPathFor(entry.id)
const currentPath = pathFor(entry.id)

/*
 * One section, so the sidebar is always this one; a page outside it — the
 * registry guides, which are published but deliberately unlisted — still gets
 * the same navigation rather than an empty rail.
 */
const docsContext = await getDocsContext(DOCS_SECTION)
const sidebar = docsContext.sidebars[DOCS_SECTION] ?? { links: [], groups: [] }
const sectionTitle = sectionTitleFor(sidebar, entry.id)

/*
 * `getSidebarPagination` is in the theme but not in its exports map, so the
 * walk lives in `lib/lotus-nav.ts` and the result is handed to the theme's own
 * `PageNavigation`.
 */
const pager =
  entry.data.pager === false ? {} : pagination(sidebar, entry.id)

const tocHeadings =
  entry.data.toc === false
    ? []
    : headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3)

const head = buildHead({
  title: entry.data.title,
  description: entry.data.description,
  pathname: Astro.url.pathname,
  site: Astro.site,
  markdownPath,
})
---

<DocsContextLayout
  title={entry.data.title}
  description={entry.data.description}
  head={head}
  currentPath={currentPath}
  currentSection={DOCS_SECTION}
  currentSlug={entry.id}
  headings={tocHeadings}
>
  <div>
    <PageHeader
      description={entry.data.description}
      markdownUrl={markdownPath}
      pageActions={PAGE_ACTIONS}
      pageUrl={currentPath}
      sectionTitle={sectionTitle}
      title={entry.data.title}
    />

    {
      entry.data.links && (
        <p class="docs-links">
          {entry.data.links.doc && (
            <a href={entry.data.links.doc} target="_blank" rel="noreferrer">
              Docs ↗
            </a>
          )}
          {entry.data.links.api && (
            <a href={entry.data.links.api} target="_blank" rel="noreferrer">
              API Reference ↗
            </a>
          )}
        </p>
      )
    }

    <div class="prose max-w-none py-8">
      <Content components={components} />
    </div>
  </div>

  <div class="xl:hidden" data-pagefind-ignore>
    <PageAside
      currentSlug={entry.id}
      headings={tocHeadings}
      markdownUrl={markdownPath}
      pageUrl={currentPath}
      tableOfContents={false}
      title={entry.data.title}
    />
  </div>

  <div data-pagefind-ignore>
    <PageMeta title={entry.data.title} />
    <PageNavigation navigation={pager} />
  </div>

  <Fragment slot="aside">
    <PageAside
      currentSlug={entry.id}
      headings={tocHeadings}
      markdownUrl={markdownPath}
      pageUrl={currentPath}
      title={entry.data.title}
    />
  </Fragment>
</DocsContextLayout>
