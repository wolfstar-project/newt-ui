---
import ComponentPreview from "../components/mdx/ComponentPreview.astro"
import CreateApp from "../components/create/CreateApp"
import Page from "../layouts/Page.astro"

/*
 * The builder. Controls and output are one React island; the preview beside
 * them is the ordinary Astro one, so the components on show are the same ones
 * every documentation page renders, in whichever framework the reader picked.
 * The island writes the preset onto the preview's wrapper as custom
 * properties, which is exactly what the CSS block it prints would do.
 */
---

<Page
  title="newt/create"
  description="Pick a brand hue, a radius scale and a font, and leave with the command that builds a project already wearing them."
>
  <main class="create" id="main">
    <header class="create-header">
      <h1>newt/create</h1>
      <p>
        Six choices, one code. The code is not a theme file — it is a short list
        of overrides for tokens that already exist, so a project that never uses
        one looks exactly like a project whose preset is the defaults. Paste it
        into <code>init</code> and the project comes out already wearing it.
      </p>
    </header>

    <div class="create-layout">
      <CreateApp client:load />

      <section class="create-preview newt-root" data-create-preview>
        <h2>How it lands</h2>
        <ComponentPreview name="button" />
        <ComponentPreview name="select-menu" />
        <ComponentPreview name="chat-window" size="full" />
      </section>
    </div>
  </main>
</Page>
