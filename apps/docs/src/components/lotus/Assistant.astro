---
/*
 * Lotus renders this slot from `BaseLayout`, on every page, just before
 * `</body>`. It is meant for a chat widget; with no assistant configured it is
 * the one place a site can put a script that has to exist everywhere, which is
 * exactly what `Base.astro` used to be for.
 *
 * Three things live here.
 *
 * The service worker registration, which was `<script src="/src/pwa.ts">` in
 * the old layout. Without it the manifest is advertised and nothing installs.
 *
 * The theme bridge. Lotus owns `data-theme` on `<html>` and stores its choice
 * under `lotus-theme`, with a third state — `system` — that the `--newt-*`
 * palette has no idea about. The site's own toggle owns `data-newt-theme` and
 * `newt-ui:theme`. The listener below keeps the two in step in the one
 * direction the site does not already handle: when something changes
 * `data-theme` (the theme's own control, or another tab), `system` is resolved
 * against the media query and mirrored onto `data-newt-theme`, so the chrome,
 * every live demo and every Expressive Code block change together.
 *
 * And the search results' trailing slashes, explained where they are fixed.
 */
---

<script src="/src/pwa.ts"></script>

<script>
  import { $theme, isTheme } from "@/stores/theme"

  const root = document.documentElement

  function resolve(value: string | null | undefined): "dark" | "light" {
    if (value === "light" || value === "dark") return value
    return globalThis.matchMedia?.("(prefers-color-scheme: light)").matches === true
      ? "light"
      : "dark"
  }

  function mirror(): void {
    const resolved = resolve(root.dataset.theme)
    if (root.dataset.newtTheme !== resolved) $theme.set(resolved)
  }

  mirror()

  /*
   * `data-theme` is written by the theme's own controls and by its pre-paint
   * script; neither fires an event, so the attribute itself is what is watched.
   */
  new MutationObserver(mirror).observe(root, {
    attributeFilter: ["data-theme"],
  })

  /* And the other direction, so the theme's storage does not drift. */
  $theme.subscribe((theme) => {
    if (isTheme(theme)) {
      root.dataset.theme = theme
      try {
        localStorage.setItem("lotus-theme", theme)
      } catch {
        /* private mode with storage disabled: the attribute is enough */
      }
    }
  })

  /*
   * Pagefind builds a result's URL from the file it indexed, so
   * `dist/docs/components/button/index.html` comes back as
   * `/docs/components/button/`. This site is `trailingSlash: "never"` and
   * serves that path as a 404 — confirmed against `astro preview`, which is
   * stricter than most hosts but is the only contract the repo controls.
   *
   * The theme reads `data.url` straight through and offers no hook, and
   * Pagefind has no option to drop the slash, so the links are corrected in
   * the dialog after the provider renders them. Same-origin paths only, and
   * never the root, which is the one path whose slash is the whole path.
   */
  const dialog = document.getElementById("lotus-search-dialog")

  if (dialog) {
    function trim(): void {
      for (const link of dialog!.querySelectorAll("a[href]")) {
        const href = link.getAttribute("href")
        if (href === null || href.startsWith("#")) continue

        const url = new URL(href, location.origin)
        if (url.origin !== location.origin) continue
        if (url.pathname === "/" || !url.pathname.endsWith("/")) continue

        link.setAttribute(
          "href",
          url.pathname.slice(0, -1) + url.search + url.hash
        )
      }
    }

    new MutationObserver(trim).observe(dialog, {
      childList: true,
      subtree: true,
    })
  }
</script>
