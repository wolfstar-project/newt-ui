---
import { SITE } from "../../lib/site"
import FrameworkSwitcher from "./FrameworkSwitcher"
import Search from "./Search.astro"
import ThemeToggle from "./ThemeToggle.astro"
import Wordmark from "./Wordmark.astro"

const pathname = Astro.url.pathname

function isActive(href: string): boolean {
  return pathname === href || pathname.startsWith(`${href}/`)
}
---

<header class="site-header">
  <div class="site-header-inner">
    <button
      type="button"
      class="icon-button sidebar-toggle"
      data-sidebar-toggle
      aria-expanded="false"
      aria-controls="docs-sidebar"
      aria-label="Open the navigation"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </g>
      </svg>
    </button>

    <Wordmark />

    <nav class="site-nav" aria-label="Main">
      {
        SITE.nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header-actions">
      <Search />
      <FrameworkSwitcher client:load />
      <ThemeToggle />
      <a
        class="icon-button"
        href={SITE.github}
        target="_blank"
        rel="noreferrer"
        aria-label="Source on GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .26.18.58.69.48A10 10 0 0 0 12 2Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>
