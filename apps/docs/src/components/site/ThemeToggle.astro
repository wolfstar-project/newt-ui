---
/*
 * Flips `data-newt-theme` on the document, which is the same selector the
 * opt-in light palette uses, so the chrome and every live demo change together.
 */
---

<button type="button" class="icon-button" data-theme-toggle aria-label="Toggle theme">
  <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
  </svg>
  <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"
      ></path>
    </g>
  </svg>
</button>

<script>
  import { $theme, toggleTheme } from "@/stores/theme"

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => toggleTheme())
    $theme.subscribe((theme) => {
      button.setAttribute(
        "aria-label",
        theme === "dark" ? "Switch to the light theme" : "Switch to the dark theme"
      )
    })
  }
</script>
