---
import {
  FRAMEWORK_MARKS,
  markTint,
  type GlyphPart,
} from "../../lib/framework-marks"
import type { FrameworkId } from "../../lib/install-targets"

/*
 * The Astro half of the glyphs. The shapes live in `lib/framework-marks.ts`
 * because newt/create draws the same set from React.
 */
interface Props {
  readonly id: FrameworkId
  readonly class?: string
}

const { id, class: className } = Astro.props
const parts: readonly GlyphPart[] = FRAMEWORK_MARKS[id]
const tint = markTint(id)
---

<svg
  viewBox="0 0 24 24"
  class:list={["framework-glyph", className]}
  data-tint={tint}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    parts.map((part) =>
      part.kind === "path" ? (
        <path
          d={part.d}
          fill={part.filled ? "currentColor" : undefined}
          stroke={part.filled ? "none" : undefined}
        />
      ) : (
        <circle
          cx={part.cx}
          cy={part.cy}
          r={part.r}
          fill={part.filled ? "currentColor" : undefined}
          stroke={part.filled ? "none" : undefined}
        />
      )
    )
  }
</svg>
