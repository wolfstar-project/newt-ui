---
import type { FrameworkId } from "../../lib/install-targets"

/*
 * One glyph per installation target. They are drawn here rather than pulled
 * from each project's brand kit: a framework is recognised by its silhouette
 * long before its wordmark is legible at this size, and a hand-drawn path in
 * `currentColor` follows the theme, the light palette and a hover state for
 * free. The two Vite entries share the Vite bolt and are told apart by their
 * titles, with the framework hue as reinforcement.
 */
interface Props {
  readonly id: FrameworkId
  readonly class?: string
}

const { id, class: className } = Astro.props

const tint = id === "vite-react" ? "react" : id === "vite-vue" ? "vue" : undefined
---

<svg
  viewBox="0 0 24 24"
  class:list={["framework-glyph", className]}
  data-tint={tint}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    id === "next" && (
      <Fragment>
        <circle cx="12" cy="12" r="9" />
        <path d="M9.2 15.5v-7l6 7" />
        <path d="M14.6 8.5v3.4" />
      </Fragment>
    )
  }
  {
    (id === "vite-react" || id === "vite-vue") && (
      <Fragment>
        <path d="M2.8 5.2 12 21.5 21.2 5.2" />
        <path
          d="M13.4 7.6 10.6 13h2.4l-.9 4.2 3.5-5.8h-2.5z"
          fill="currentColor"
          stroke="none"
        />
      </Fragment>
    )
  }
  {
    id === "nuxt" && (
      <Fragment>
        <path d="M9.5 19.5h11L15 9.5z" />
        <path d="M8.2 12.2 3.5 19.5h5.4" />
      </Fragment>
    )
  }
  {
    id === "astro" && (
      <Fragment>
        <path d="M12 2.5 6.5 20.5" />
        <path d="M12 2.5 17.5 20.5" />
        <path d="M8.6 17.6c-.6 1.9.6 3.6 3.4 3.6s4-1.7 3.4-3.6" />
      </Fragment>
    )
  }
  {
    id === "tanstack-start" && (
      <Fragment>
        <path d="M4 8 12 4l8 4-8 4z" />
        <path d="M4 13.5 12 17.5l8-4" />
        <path d="M4 17.5 12 21.5l8-4" />
      </Fragment>
    )
  }
  {
    id === "react-router" && (
      <Fragment>
        <path d="M4.5 17.5c3.5 0 3.5-11 7-11s3.5 11 7 11" />
        <circle cx="4.5" cy="17.5" r="1.7" fill="currentColor" stroke="none" />
        <circle cx="18.5" cy="17.5" r="1.7" fill="currentColor" stroke="none" />
      </Fragment>
    )
  }
  {
    id === "laravel" && (
      <Fragment>
        <path d="M3 14 7 7.5 11 14 7 20.5z" />
        <path d="M12 11 16 4.5 20 11l-4 6.5z" />
      </Fragment>
    )
  }
  {
    id === "manual" && (
      <path d="M17.5 3.5a4.5 4.5 0 0 0-4.3 5.8L4 18.5 5.5 20l9.2-9.2a4.5 4.5 0 0 0 5.8-4.3l-2.7 2.7-2.8-.8-.8-2.8z" />
    )
  }
  {
    id === "html" && (
      <Fragment>
        <path d="M9 6.5 4 12l5 5.5" />
        <path d="M15 6.5 20 12l-5 5.5" />
        <path d="M13.2 4.5 10.8 19.5" />
      </Fragment>
    )
  }
</svg>
