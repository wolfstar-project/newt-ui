</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-copy-page]"
  )) {
    const trigger = root.querySelector<HTMLButtonElement>(".copy-page-trigger")
    const menu = root.querySelector<HTMLElement>(".copy-page-menu")
    if (!trigger || !menu) continue

    const items = [...menu.querySelectorAll<HTMLElement>("[role='menuitem']")]

    const setOpen = (open: boolean) => {
      menu.hidden = !open
      trigger.setAttribute("aria-expanded", String(open))
    }

    /* The arrows walk the menu; the first and last wrap into each other. */
    const focusItem = (index: number) => {
      const item = items[(index + items.length) % items.length]
      item?.focus()
    }

    trigger.addEventListener("click", () => setOpen(menu.hidden !== false))

    trigger.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return
      event.preventDefault()
      setOpen(true)
      focusItem(event.key === "ArrowDown" ? 0 : items.length - 1)
    })

    menu.addEventListener("keydown", (event) => {
      // SAFETY: the handler is on the menu, so the focused element is one of
      // its rows; `indexOf` returns -1 for anything else, which the arrows
      // then treat as "start from the top".
      const current = items.indexOf(document.activeElement as HTMLElement)
      if (event.key === "ArrowDown") {
        event.preventDefault()
        focusItem(current + 1)
      } else if (event.key === "ArrowUp") {
        event.preventDefault()
        focusItem(current - 1)
      } else if (event.key === "Home") {
        event.preventDefault()
        focusItem(0)
      } else if (event.key === "End") {
        event.preventDefault()
        focusItem(items.length - 1)
      }
    })

    document.addEventListener("click", (event) => {
      // SAFETY: a click event's target is always a Node in the document.
      const target = event.target as Node
      if (!root.contains(target)) setOpen(false)
    })

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || menu.hidden) return
      setOpen(false)
      trigger.focus()
    })

    /*
     * Two things in this menu copy to the clipboard: the page itself, fetched
     * from its markdown twin, and the MCP config, already known at build time.
     * Both share the same feedback — only the title changes, so the sentence
     * under it still says what the row did.
     */
    for (const button of menu.querySelectorAll<HTMLButtonElement>(
      "[data-copy-markdown], [data-copy-text]"
    )) {
      const label = button.querySelector<HTMLElement>("[data-copy-label]")
      if (!label) continue

      button.addEventListener("click", async () => {
        const original = label.textContent
        try {
          const text =
            button.dataset.copyText ??
            (await (async () => {
              const path = root.dataset.markdown
              if (!path) throw new Error("No markdown path on this menu.")
              return (await fetch(path)).text()
            })())
          await navigator.clipboard.writeText(text)
          label.textContent = "Copied"
        } catch {
          label.textContent = "Copy failed"
        }
        setTimeout(() => {
          label.textContent = original
          setOpen(false)
        }, 1200)
      })
    }
  }
</script>
