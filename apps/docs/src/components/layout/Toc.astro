---
import { componentHistory } from "../../lib/component-history"
import {
  componentSources,
  pageSourcePath,
  routeComponent,
} from "../../lib/page-source"
import { SITE } from "../../lib/site"

/*
 * Blume's `TableOfContents` layout slot: an "On this page" label over the
 * page's sections, set against a hairline rail. The sub-sections step in from
 * it, and the section being read is marked on the rail itself as the reader
 * scrolls. Blume already filters the headings to depths 2 and 3.
 *
 * Under the outline the rail says where the page comes from: the file it is
 * written in, its Markdown twin, and — on a component page — one link per
 * flavour to the component's own source.
 *
 * The rail is desktop only, as it always was. Blume also renders this slot as
 * a `mobile` dropdown above the content on narrow screens; the old site had
 * nothing there, so that variant renders nothing.
 */
interface Props {
  readonly headings: readonly {
    readonly depth: number
    readonly slug: string
    readonly text: string
  }[]
  readonly title: string
  readonly variant: "mobile" | "desktop"
}

const { headings, variant } = Astro.props

/* The slot is not handed the route, so it is read off the URL. */
const route = Astro.url.pathname.replace(/\/$/, "")
const meta = routeComponent(route)
const sourcePath = pageSourcePath(route)
const sources = meta === undefined ? [] : componentSources(meta)

/*
 * The changelog under a component page is drawn by the `PageFooter` slot, not
 * written in the page, so Blume does not know it as a heading. It is a
 * section of the page all the same, and it goes last.
 */
const sections =
  meta !== undefined && componentHistory(meta.name).length > 0
    ? [...headings, { depth: 2, slug: "changelog", text: "Changelog" }]
    : headings
---

{
  variant === "desktop" && sections.length > 0 && (
    <nav class="toc" aria-labelledby="toc-title" data-toc>
      <p class="toc-title" id="toc-title">
        On this page
      </p>
      <ul class="toc-list">
        {sections.map((heading) => (
          <li data-depth={heading.depth}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
      <div class="toc-links">
        {sourcePath !== undefined && (
          <ul>
            <li>
              <a
                href={`${SITE.github}/edit/main/apps/docs/${sourcePath}`}
                target="_blank"
                rel="noreferrer"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M4 20h4L19 9l-4-4L4 16v4Zm10-14 4 4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                Edit this page
              </a>
            </li>
            <li>
              <a href={`${route}.md`}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M4 6h16v12H4V6Zm3 9V9l2.5 3L12 9v6m5-6v5m0 0-2-2m2 2 2-2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                View as Markdown
              </a>
            </li>
          </ul>
        )}
        {sources.length > 0 && (
          <>
            <p class="toc-title">Source</p>
            <ul>
              {sources.map((source) => (
                <li>
                  <a href={source.href} target="_blank" rel="noreferrer">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="m9 8-4 4 4 4m6-8 4 4-4 4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </nav>
  )
}

<script>
  /*
   * `astro:page-load` rather than top-level code: Blume's client router swaps
   * pages in place, and a module script runs once per real load, so the
   * observer has to be rebuilt for each page it lands on.
   */
  let observer: IntersectionObserver | undefined

  function init(): void {
    observer?.disconnect()
    const toc = document.querySelector<HTMLElement>("[data-toc]")
    if (!toc) return
    const links = [
      ...toc.querySelectorAll<HTMLAnchorElement>(".toc-list a[href^='#']"),
    ]
    /*
     * The top band of the viewport is what counts as "here": a heading that
     * has scrolled past the header is the section being read, not the one
     * about to enter from the bottom.
     */
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          for (const link of links) {
            link.toggleAttribute(
              "data-active",
              decodeURIComponent(link.hash.slice(1)) === entry.target.id
            )
          }
        }
      },
      { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
    )
    for (const link of links) {
      const target = document.getElementById(
        decodeURIComponent(link.hash.slice(1))
      )
      if (target) observer.observe(target)
    }
  }

  document.addEventListener("astro:page-load", init)
</script>
