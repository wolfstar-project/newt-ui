---
import { COMPONENTS } from "../../lib/registry"
import FrameworkSwitcher from "../site/FrameworkSwitcher"

/*
 * Blume's `Sidebar` layout slot, drawn the way the site drew it before the
 * Lotus port: a small uppercase label per group and a flat list of links
 * under it, with the component count at the foot. Blume hands over the tree
 * it built from `navigation.sidebar` in `blume.config.ts`, so the order and
 * the labels are still the ones `NAV` declares; this file only draws them.
 * The drawer around it — fixed on mobile, sticky on desktop — is Blume's.
 * Under 48rem the header has no room for the React/Vue switch, so the drawer
 * carries it at the top.
 *
 * The tree holds two books — the guides and the component reference — and a
 * reader is only ever in one of them. Showing both made the component list
 * start two screens down, so the sidebar draws the half the current page
 * belongs to and a two-way switch above it leads to the other. A group is
 * part of the reference when every page in it is a component page.
 */
const COMPONENTS_ROOT = "/docs/components"
type Node =
  | { readonly kind: "page"; readonly label: string; readonly route: string }
  | {
      readonly kind: "group"
      readonly label: string
      readonly route?: string
      readonly children: readonly Node[]
    }

interface Props {
  readonly items: readonly Node[]
  readonly currentRoute: string
}

const { items, currentRoute } = Astro.props

/** A group's pages, with any nested group flattened into the same list. */
function pagesOf(nodes: readonly Node[]): { label: string; route: string }[] {
  return nodes.flatMap((node) =>
    node.kind === "page"
      ? [{ label: node.label, route: node.route }]
      : [
          ...(node.route ? [{ label: node.label, route: node.route }] : []),
          ...pagesOf(node.children),
        ]
  )
}

const inReference =
  currentRoute === COMPONENTS_ROOT ||
  currentRoute.startsWith(`${COMPONENTS_ROOT}/`)

const loose = inReference
  ? []
  : pagesOf(items.filter((node) => node.kind === "page"))
const groups = items
  .flatMap((node) =>
    node.kind === "group"
      ? [{ label: node.label, pages: pagesOf(node.children) }]
      : []
  )
  .filter(
    (group) =>
      group.pages.every((page) =>
        page.route.startsWith(`${COMPONENTS_ROOT}/`)
      ) === inReference
  )

const sections = [
  { href: "/docs", label: "Guides", current: !inReference },
  { href: COMPONENTS_ROOT, label: "Components", current: inReference },
]
---

<div class="sidebar-nav">
  <div class="sidebar-framework">
    <FrameworkSwitcher client:load />
  </div>
  <nav class="sidebar-sections" aria-label="Documentation sections">
    {
      sections.map((section) => (
        <a href={section.href} aria-current={section.current ? "true" : undefined}>
          {section.label}
        </a>
      ))
    }
  </nav>
  {
    inReference && (
      <div class="sidebar-group">
        <ul>
          <li>
            <a
              href={COMPONENTS_ROOT}
              aria-current={currentRoute === COMPONENTS_ROOT ? "page" : undefined}
            >
              All components
            </a>
          </li>
        </ul>
      </div>
    )
  }
  {
    loose.length > 0 && (
      <div class="sidebar-group">
        <ul>
          {loose.map((page) => (
            <li>
              <a
                href={page.route}
                aria-current={page.route === currentRoute ? "page" : undefined}
              >
                {page.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  {
    groups.map((group) => (
      <div class="sidebar-group">
        <p class="sidebar-group-label">{group.label}</p>
        <ul>
          {group.pages.map((page) => (
            <li>
              <a
                href={page.route}
                aria-current={page.route === currentRoute ? "page" : undefined}
              >
                {page.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
<p class="sidebar-footer">{COMPONENTS.length} components</p>
