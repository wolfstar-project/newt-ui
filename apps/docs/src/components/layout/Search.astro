---
import BlumeSearch from "blume/components/layout/Search.astro"

import FrameworkPrePaint from "../site/FrameworkPrePaint.astro"
import FrameworkSwitcher from "../site/FrameworkSwitcher"

/*
 * Blume's `Search` layout slot, with the one control this site adds to the
 * header beside it: the React/Vue switch that decides what every demo, code
 * tab, install path and usage snippet shows. The search trigger itself is the
 * built-in, handed every prop the header gives the slot.
 *
 * This slot reaches the docs pages only — Blume's `PageLayout`, which the
 * custom pages use, takes no slot overrides — so `SiteLayout.astro` renders
 * the same two pieces itself.
 */
const props = Astro.props
---

<FrameworkPrePaint />
<FrameworkSwitcher client:load />
<BlumeSearch {...props} />
