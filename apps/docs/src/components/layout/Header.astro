---
import type { ComponentProps } from "astro/types"
import BlumeSearch from "blume/components/layout/Search.astro"
import data from "blume:data"

import { SITE } from "../../lib/site"
import FrameworkPrePaint from "../site/FrameworkPrePaint.astro"
import FrameworkSwitcher from "../site/FrameworkSwitcher"
import Wordmark from "../site/Wordmark.astro"

/*
 * Blume's `Header` layout slot, replaced with the header this site had before
 * the Lotus port: the hamburger, the wordmark, the primary links, and on the
 * right search, the React/Vue switch, the theme toggle and the repository.
 *
 * Blume's own header carries the click handling for the theme toggle and the
 * navigation drawer, so replacing it means carrying that here too. The two
 * buttons keep Blume's `data-blume-theme-toggle` / `data-blume-nav-toggle`
 * hooks, so the theme script in `<head>`, the drawer's inert handling and the
 * scrim Blume renders behind the drawer all keep working unchanged. The
 * search is Blume's, rendered as it is; `theme.css` restyles its trigger into
 * the old labelled box.
 */
type SearchProps = ComponentProps<typeof BlumeSearch>

interface Props {
  readonly route: string
  readonly searchEnabled: boolean
  readonly assistantEnabled?: boolean
  readonly searchLocale?: string
  readonly searchVersion?: string | null
  readonly searchStrings?: SearchProps["strings"]
  readonly navigation: SearchProps["navigation"]
}

const {
  route,
  searchEnabled,
  assistantEnabled,
  searchLocale,
  searchVersion = null,
  searchStrings,
  navigation,
} = Astro.props

function isActive(href: string): boolean {
  return route === href || route.startsWith(`${href}/`)
}

/*
 * Delegated and installed once per real load: Blume's client router swaps the
 * body on navigation and re-runs inline scripts, and a second set of
 * listeners would toggle the theme twice per click.
 */
const chromeScript = `(()=>{if(window.__newtChrome)return;window.__newtChrome=true;const save=(k,v)=>{try{localStorage.setItem(k,v)}catch{}};const drawerTop=()=>{const h=document.querySelector("[data-blume-header]");if(h)document.documentElement.style.setProperty("--blume-drawer-top",h.getBoundingClientRect().bottom+"px")};document.addEventListener("click",(e)=>{const el=e.target instanceof Element?e.target:null;if(!el)return;if(el.closest("[data-blume-theme-toggle]")){const d=document.documentElement;const next=d.dataset.theme==="dark"?"light":"dark";d.dataset.theme=next;save("blume-theme",next)}if(el.closest("[data-blume-nav-toggle]")){if(document.documentElement.toggleAttribute("data-blume-nav-open"))drawerTop()}});document.addEventListener("keydown",(e)=>{if(e.key==="Escape")document.documentElement.removeAttribute("data-blume-nav-open")});addEventListener("resize",()=>{const d=document.documentElement;if(d.hasAttribute("data-blume-nav-open")&&matchMedia("(min-width:64rem)").matches)d.removeAttribute("data-blume-nav-open")})})();`
---

<FrameworkPrePaint />
<header class="site-header" data-blume-header>
  <div class="site-header-inner">
    <button
      type="button"
      class="icon-button sidebar-toggle"
      data-blume-nav-toggle
      aria-expanded="false"
      aria-controls="blume-nav-drawer"
      aria-label="Open the navigation"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </g>
      </svg>
    </button>

    <Wordmark />

    <nav class="site-nav" aria-label="Main">
      {
        SITE.nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header-actions">
      {
        searchEnabled && (
          <BlumeSearch
            assistantEnabled={assistantEnabled}
            locale={searchLocale}
            navigation={navigation}
            popularPages={data.config.search.popular}
            strings={searchStrings}
            version={searchVersion}
          />
        )
      }
      <FrameworkSwitcher client:load />
      <button
        type="button"
        class="icon-button"
        data-blume-theme-toggle
        aria-label="Toggle theme"
      >
        <svg
          class="theme-icon theme-icon-dark"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          class="theme-icon theme-icon-light"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <g
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="4.2"></circle>
            <path
              d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"
            ></path>
          </g>
        </svg>
      </button>
      <a
        class="icon-button"
        href={SITE.github}
        target="_blank"
        rel="noreferrer"
        aria-label="Source on GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .26.18.58.69.48A10 10 0 0 0 12 2Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>
<script is:inline set:html={chromeScript} />
