---
import { categories, COMPONENTS } from "../../lib/registry"
import ComponentThumb from "../site/ComponentThumb.astro"

/*
 * The whole registry on one page, grouped the way the sidebar groups it. The
 * list is read from the registry meta rather than restated, so a component
 * that gains a meta file appears here on the next build. Each tile shows the
 * component's reference example above its name, so the page can be scanned by
 * eye, and the filter narrows it by name or description.
 */
const groups = categories
  .map((category) => ({
    label: category.label,
    slug: category.slug,
    components: COMPONENTS.filter(
      (component) => component.categorySlug === category.slug
    ),
  }))
  .filter((group) => group.components.length > 0)
---

<div class="component-index not-prose" data-component-index>
  <div class="component-index-bar">
    <label class="component-index-filter">
      <span class="sr-only">Filter components</span>
      <input
        type="search"
        placeholder={`Filter ${COMPONENTS.length} components…`}
        autocomplete="off"
        spellcheck="false"
        data-component-filter
      />
    </label>
    <nav class="component-index-jump" aria-label="Categories">
      {
        groups.map((group) => (
          <a href={`#${group.slug}`}>
            {group.label}
            <span>{group.components.length}</span>
          </a>
        ))
      }
    </nav>
  </div>
  <p class="component-index-none" data-component-none hidden>
    No component matches that. Try the search in the header — it reads every page.
  </p>
  {
    groups.map((group) => (
      <section class="component-index-group" data-component-group>
        <h2 id={group.slug}>
          {group.label}
          <span>{group.components.length}</span>
        </h2>
        <ul class="component-grid">
          {group.components.map((component) => (
            <li
              class="component-tile"
              data-component-tile
              data-search={`${component.name} ${component.title} ${component.description}`.toLowerCase()}
            >
              {/* Beside the link, not inside it: an example may hold an
                  anchor of its own, and one anchor cannot contain another. */}
              <ComponentThumb name={component.name} />
              <a
                class="component-tile-title"
                href={`/docs/components/${component.name}`}
              >
                {component.title}
              </a>
              <span class="component-tile-note">{component.description}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<script>
  /*
   * Delegated from the document so the filter still works on a page Blume's
   * client router swapped in without running this module again.
   */
  document.addEventListener("input", (event) => {
    const input = event.target
    if (
      !(input instanceof HTMLInputElement) ||
      !input.matches("[data-component-filter]")
    ) {
      return
    }
    const root = input.closest("[data-component-index]")
    if (!root) return
    const query = input.value.trim().toLowerCase()
    let shown = 0
    for (const group of root.querySelectorAll<HTMLElement>(
      "[data-component-group]"
    )) {
      let inGroup = 0
      for (const tile of group.querySelectorAll<HTMLElement>(
        "[data-component-tile]"
      )) {
        const match = (tile.dataset.search ?? "").includes(query)
        tile.hidden = !match
        if (match) inGroup += 1
      }
      group.hidden = inGroup === 0
      shown += inGroup
    }
    const none = root.querySelector<HTMLElement>("[data-component-none]")
    if (none) none.hidden = shown > 0
  })
</script>
