---
import CodeBlock from "blume/components/content/CodeBlock.astro"
import Step from "blume/components/content/Step.astro"
import Steps from "blume/components/content/Steps.astro"
import Tab from "blume/components/content/Tab.astro"
import Tabs from "blume/components/content/Tabs.astro"

import {
  componentPrompt,
  findComponent,
  npmPackages,
  registryFiles,
} from "../../lib/registry"
import { SITE } from "../../lib/site"
import PmTabs from "./PmTabs.astro"

/*
 * Three ways in: the CLI, which is what almost everyone wants; the manual
 * route, which spells out every file the CLI would have written; and a prompt
 * that hands the same manual route to an AI assistant in one paste. All three
 * are derived from the component's meta file, so none can drift from what
 * `newtui add` actually does.
 */
interface Props {
  readonly name: string
}

const { name } = Astro.props

const meta = findComponent(name)
if (meta === undefined) {
  throw new Error(`<Installation name="${name}"> — no registry meta.`)
}

function langFor(path: string): string {
  if (path.endsWith(".vue")) return "vue"
  return path.endsWith(".tsx") ? "tsx" : "ts"
}

const codeProps = (framework: "react" | "vue") =>
  registryFiles(framework, meta).map(({ path, source }) => ({
    code: source ?? `// missing source for ${path}`,
    lang: langFor(path),
    title: path,
  }))

const reactFiles = codeProps("react")
const vueFiles = codeProps("vue")

const prompts = [
  { framework: "react", label: "React", text: componentPrompt("react", meta) },
  { framework: "vue", label: "Vue", text: componentPrompt("vue", meta) },
] as const

const reactPackages = npmPackages("react", meta).join(" ")
const vuePackages = npmPackages("vue", meta).join(" ")
---

<Tabs hash={false} sync={false}>
  <Tab title="CLI">
    <PmTabs cmd={`newtui@latest add ${meta.name}`} />
  </Tab>

  <Tab title="Manual">
    <Steps>
      {
        (reactPackages !== "" || vuePackages !== "") && (
          <Step title="Install the dependencies">
            {reactPackages === vuePackages ? (
              <PmTabs cmd={`--yes ${reactPackages}`} />
            ) : (
              <>
                <div data-framework="react">
                  {reactPackages === "" ? (
                    <p>The React port needs no package.</p>
                  ) : (
                    <PmTabs cmd={`--yes ${reactPackages}`} />
                  )}
                </div>
                <div data-framework="vue">
                  {vuePackages === "" ? (
                    <p>The Vue port needs no package.</p>
                  ) : (
                    <PmTabs cmd={`--yes ${vuePackages}`} />
                  )}
                </div>
              </>
            )}
          </Step>
        )
      }

      {
        meta.registryDependencies.length > 0 && (
          <Step title="Add the components it builds on">
            <p>
              {meta.registryDependencies.map((dependency, index) => (
                <>
                  {index > 0 && ", "}
                  <a href={`/docs/components/${dependency}`}>{dependency}</a>
                </>
              ))}
            </p>
          </Step>
        )
      }

      <Step title="Copy the source into your project">
        <div data-framework="react">
          {reactFiles.map((file) => (
            <CodeBlock {...file} />
          ))}
        </div>
        <div data-framework="vue">
          {vueFiles.map((file) => (
            <CodeBlock {...file} />
          ))}
        </div>
      </Step>

      <Step title="Update the import paths">
        <p>
          The files import <code>{SITE.utilsAlias}</code> and sibling components
          through the aliases in your <code>components.json</code>. Point them at
          wherever those live in your project.
        </p>
      </Step>
    </Steps>
  </Tab>

  <Tab title="Prompt">
    {
      prompts.map((prompt) => (
        <div data-framework={prompt.framework}>
          <div class="install-prompt">
          <p>
            No CLI, no <code>components.json</code>: paste this into Claude,
            Cursor, Copilot or any coding assistant and it adds {meta.title} to
            your {prompt.label} project by hand. The prompt carries the source
            of every file the CLI would write — this component's and those of
            the components it builds on — with the imports already pointed at
            the default aliases.
          </p>
          <button
            type="button"
            class="install-prompt-copy"
            data-copy-prompt={prompt.text}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M9 2a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V6.4a2 2 0 0 0-.6-1.4l-2.4-2.4A2 2 0 0 0 15.6 2H9Zm0 2h6v3a1 1 0 0 0 1 1h2v6H9V4ZM5 7a1 1 0 0 1 1 1v10h9a1 1 0 1 1 0 2H6a2 2 0 0 1-2-2V8a1 1 0 0 1 1-1Z"
              />
            </svg>
            <span data-copy-prompt-label>Copy prompt</span>
          </button>
          <span class="install-prompt-status" role="status" aria-live="polite" />
          </div>
        </div>
      ))
    }
  </Tab>
</Tabs>

<script>
  /*
   * One listener on the document, not one per button: a module script runs
   * once per real load while Blume's client router swaps pages in place, and
   * a delegated listener keeps working on every page it lands on.
   */
  document.addEventListener("click", async (event) => {
    // SAFETY: a click event's target is always a Node; `closest` lives on
    // Element, and a text node has no prompt button to find anyway.
    const target = event.target as Element | null
    const button = target?.closest?.<HTMLButtonElement>("[data-copy-prompt]")
    if (!button) return

    const label = button.querySelector<HTMLElement>("[data-copy-prompt-label]")
    const status = button.parentElement?.querySelector<HTMLElement>(
      ".install-prompt-status"
    )
    let message: string
    try {
      await navigator.clipboard.writeText(button.dataset.copyPrompt ?? "")
      message = "Copied"
    } catch {
      message = "Copy failed"
    }
    if (label) label.textContent = message
    if (status) status.textContent = `Prompt ${message.toLowerCase()}`
    setTimeout(() => {
      if (label) label.textContent = "Copy prompt"
      if (status) status.textContent = ""
    }, 1600)
  })
</script>
