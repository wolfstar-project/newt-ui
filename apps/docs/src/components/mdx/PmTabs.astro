---
import CodeBlock from "blume/components/content/CodeBlock.astro"
import Tab from "blume/components/content/Tab.astro"
import Tabs from "blume/components/content/Tabs.astro"

/*
 * One command, four package managers. `cmd` is the bare package and arguments
 * — `newtui@latest add button` — and each tab prefixes its own runner, so a
 * page never has to spell the same command out four times.
 *
 * The groups share `syncKey="pm"`: a reader who picks pnpm once sees pnpm in
 * every command on the page, and nothing else on the page moves with it.
 */
interface Props {
  readonly cmd: string
}

const { cmd } = Astro.props

const RUNNERS = [
  ["pnpm", `pnpm dlx ${cmd}`],
  ["npm", `npx ${cmd}`],
  ["yarn", `yarn dlx ${cmd}`],
  ["bun", `bunx ${cmd}`],
] as const
---

<Tabs hash={false} syncKey="pm">
  {
    RUNNERS.map(([label, command]) => (
      <Tab title={label}>
        <CodeBlock code={command} lang="bash" icons={false} />
      </Tab>
    ))
  }
</Tabs>
