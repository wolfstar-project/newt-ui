---
import Tab from "blume/components/content/Tab.astro"
import Tabs from "blume/components/content/Tabs.astro"

import { DIRECTORY, DIRECTORY_SOURCES } from "../../lib/directory"

/*
 * Every third-party registry the CLI can install from by name, one tab per
 * framework: a React project reads shadcn/ui's directory and a Vue project
 * reads shadcn-vue's, and the two share no entries. The list is a snapshot,
 * so each tab says where the live one is.
 */
const frameworks = ["react", "vue"] as const
---

<div class="registry-directory not-prose">
  <Tabs hash={false} sync={false}>
    {
      frameworks.map((framework) => {
        const entries = DIRECTORY[framework]
        const source = DIRECTORY_SOURCES[framework]
        return (
          <Tab title={`${source.label} (${entries.length})`}>
            <div data-registry-directory>
              <label class="component-index-filter">
                <span class="sr-only">Filter {source.label} registries</span>
                <input
                  type="search"
                  placeholder={`Filter ${entries.length} registries…`}
                  autocomplete="off"
                  spellcheck="false"
                  data-registry-filter
                />
              </label>
              <p class="component-index-none" data-registry-none hidden>
                No registry matches that. The live list is at{" "}
                <a href={source.site}>{new URL(source.site).host}</a>.
              </p>
              <ul class="registry-list">
                {entries.map((entry) => (
                  <li
                    class="registry-entry"
                    data-registry-entry
                    data-search={`${entry.name} ${entry.description ?? ""}`.toLowerCase()}
                  >
                    <div class="registry-entry-head">
                      <a href={entry.homepage} rel="noopener noreferrer">
                        {entry.name}
                      </a>
                      <code>newtui add {entry.name}/&lt;item&gt;</code>
                    </div>
                    {entry.description && <p>{entry.description}</p>}
                  </li>
                ))}
              </ul>
            </div>
          </Tab>
        )
      })
    }
  </Tabs>
</div>

<script>
  /* Delegated, so the filter survives Blume's client router. */
  document.addEventListener("input", (event) => {
    const input = event.target
    if (
      !(input instanceof HTMLInputElement) ||
      !input.matches("[data-registry-filter]")
    ) {
      return
    }
    const root = input.closest("[data-registry-directory]")
    if (!root) return
    const query = input.value.trim().toLowerCase()
    let shown = 0
    for (const entry of root.querySelectorAll<HTMLElement>(
      "[data-registry-entry]"
    )) {
      const match = (entry.dataset.search ?? "").includes(query)
      entry.hidden = !match
      if (match) shown += 1
    }
    const none = root.querySelector<HTMLElement>("[data-registry-none]")
    if (none) none.hidden = shown > 0
  })
</script>
