---
import { componentTokens } from "../../lib/html-registry"
import { findComponent, rootClasses } from "../../lib/registry"

/*
 * Every component draws its colours, radii, shadows and timings from the
 * `--newt-*` layer rather than from values of its own, which is what makes
 * restyling one variable restyle the whole library.
 */
interface Props {
  readonly name: string
}

const { name } = Astro.props

const meta = findComponent(name)
if (meta === undefined) {
  throw new Error(`<TokensNote name="${name}"> — no registry meta.`)
}

const rootClass = rootClasses[meta.name]

/*
 * The list is read out of the component's stylesheet, so it is the surface a
 * reader can actually theme and it cannot go stale. Private custom properties
 * a component sets for itself (`--newt-dir`, per-instance values) are tokens
 * only if `tokens.css` declares them, which the colours page settles.
 */
const tokens = componentTokens(meta.name)

/*
 * A swatch is only drawn for a token that is a colour. A radius or a font
 * used as a `background` is invalid when it is computed, which resets the
 * property to transparent and leaves an empty box.
 */
const COLOUR =
  /^--newt-(?:bg|text|border|brand|online|idle|dnd|offline|danger|mention|spoiler|code)(?:-|$)/
---

<p>
  {meta.title} reads its colours, radii and motion from the <code>--newt-*</code> tokens
  installed with the library. Override a token and every component that
  reads it follows, including this one — see{" "}
  <a href="/docs/installation#tokens">the token layer</a>.
  {
    rootClass && (
      <>
        {" "}
        In the plain HTML and CSS distribution the same component is{" "}
        <code>{rootClass}</code>.
      </>
    )
  }
</p>

{
  tokens.length > 0 && (
    <div class="not-prose">
    <ul class="token-chips" aria-label={`Tokens ${meta.title} reads`}>
      {tokens.map((token) => (
        <li>
          {COLOUR.test(token) && (
            <span
              class="token-chip-swatch"
              style={`background:var(${token})`}
              aria-hidden="true"
            />
          )}
          <code>{token}</code>
        </li>
      ))}
    </ul>
    </div>
  )
}
