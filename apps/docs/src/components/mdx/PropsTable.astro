---
import TypeTable from "blume/components/content/TypeTable.astro"

/*
 * A component's public surface, stated once per part. The rows are written by
 * hand in the page rather than derived from the source: the types a reader
 * needs are the documented ones, not every prop the DOM element also accepts.
 *
 * Rendered with Blume's own type table, so the registry's tables look like
 * every other table on the site; this file only translates the row shape the
 * 71 component pages already write.
 */
interface PropRow {
  readonly name: string
  readonly type: string
  readonly default?: string
  readonly description: string
}

interface Props {
  /** The exported part these props belong to, e.g. `Button`. */
  readonly of?: string
  readonly rows: readonly PropRow[]
}

const { of: part, rows } = Astro.props

const type = Object.fromEntries(
  rows.map((row) => [
    row.name,
    { type: row.type, description: row.description, default: row.default },
  ])
)
---

<div class="props-table">
  {part && <p class="props-table-part"><code>{part}</code></p>}
  <TypeTable type={type} />
</div>
