---
import CreateApp from "../src/components/create/CreateApp"
import CreateCard from "../src/components/create/CreateCard.astro"
import SiteLayout from "./_site/SiteLayout.astro"

/*
 * The builder: a customizer beside a canvas of real components.
 *
 * The customizer is one React island. The canvas is ordinary Astro, so the
 * components on show are the ones every documentation page renders, in
 * whichever framework the header switch names. The island writes the preset
 * onto the canvas as custom properties, which is exactly what the CSS block
 * it prints would do in a project.
 */
---

<SiteLayout
  title="newt/create"
  description="Pick a brand hue, a radius scale and a font, and leave with the command that builds a project already wearing them."
  route={Astro.url.pathname}
>
  <div class="create-shell">
    <CreateApp client:load />

    <section
      class="create-canvas newt-root"
      data-create-preview
      aria-label="Preview"
    >
      <div class="create-cards">
        <CreateCard name="button" />
        <CreateCard name="chat-window" flush />
        <CreateCard name="form-fields" />
        <CreateCard name="select-menu" />
        <CreateCard name="tabs" />
        <CreateCard name="alert" />
        <CreateCard name="checkbox-group" />
        <CreateCard name="slider" />
        <CreateCard name="progress" />
        <CreateCard name="poll" />
        <CreateCard name="embed" />
        <CreateCard name="avatar-group" />
        <CreateCard name="pagination" />
        <CreateCard name="reaction" />
        <CreateCard name="toast" />
      </div>
    </section>
  </div>
</SiteLayout>
