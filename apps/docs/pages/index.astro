---
import Card from "blume/components/content/Card.astro"
import CardGroup from "blume/components/content/CardGroup.astro"

import FrameworkGrid from "../src/components/mdx/FrameworkGrid.astro"
import PmTabs from "../src/components/mdx/PmTabs.astro"
import ComponentThumb from "../src/components/site/ComponentThumb.astro"
import { categories, COMPONENTS, findComponent } from "../src/lib/registry"
import { SITE } from "../src/lib/site"
import SiteLayout from "./_site/SiteLayout.astro"

/*
 * The wall: the library shown rather than described. Every tile is a
 * component's reference example from the HTML distribution, so the page
 * paints two dozen of them without mounting an island, and all of them read
 * the same tokens — which is what lets the brand switch above the wall
 * re-tint every tile at once, the way a project's own override would.
 */
const WALL = [
  "message-group",
  "member-list",
  "button",
  "poll",
  "embed",
  "voice-channel",
  "select-menu",
  "user-profile",
  "toast",
  "slash-command-suggestions",
  "invite",
  "reaction",
  "role-tag",
  "tabs",
  "attachment",
  "context-menu",
  "progress",
  "badge",
  "server-banner",
  "radio",
  "typing-indicator",
  "thread-preview",
  "form-fields",
  "dropdown",
].flatMap((name) => {
  const meta = findComponent(name)
  return meta === undefined ? [] : [meta]
})

/* The example hues `/create` offers; the first is the token's own value. */
const BRANDS = [
  { name: "Blurple", value: "" },
  { name: "Violet", value: "#7a5af8" },
  { name: "Teal", value: "#1abc9c" },
  { name: "Amber", value: "#f0b232" },
  { name: "Rose", value: "#eb459e" },
] as const

const STATS = [
  { value: String(COMPONENTS.length), label: "components and blocks" },
  { value: String(categories.length), label: "categories" },
  { value: "3", label: "flavours: React, Vue, HTML" },
  { value: "0", label: "runtime dependencies" },
] as const

const PRINCIPLES = [
  {
    icon: "swatch-book",
    title: "One token system, three targets",
    body: "The tokens are declared once and every surface reads them: the plain HTML and CSS build, the React files, and the Vue single file components. Change a token and all three move together.",
  },
  {
    icon: "code-xml",
    title: "You own the code",
    body: `The CLI writes component source into your project and stops there. A component you need to bend is a file you already have, under ${SITE.license}.`,
  },
  {
    icon: "message-square",
    title: "Built for chat-shaped products",
    body: "Messages, embeds, polls, slash commands, member lists, voice rows: the parts a bot dashboard or a community tool needs, not another generic card and table set.",
  },
  {
    icon: "pause",
    title: "No motion by default",
    body: "Hover, focus, online, do-not-disturb and loading are carried by colour, border and shape — the status dot states its mode by its outline, not by a pulse.",
  },
  {
    icon: "accessibility",
    title: "Accessible by construction",
    body: "Body text meets WCAG AA contrast, every control is reachable by Tab with a visible focus ring, and presence is announced rather than left to colour alone.",
  },
  {
    icon: "languages",
    title: "Right-to-left ready",
    body: "Logical properties throughout, so a component mirrors under dir=\"rtl\" without a second stylesheet. Every preview on this site can be flipped to check.",
  },
] as const

const AGENTS = [
  {
    href: "/docs/mcp",
    title: "MCP server",
    code: "npx newtui@latest mcp init",
    body: "Lets an agent search these docs and read a component's page before it writes a line.",
  },
  {
    href: "/docs/skills",
    title: "Agent skill",
    code: "npx skills add wolfstar-project/newt-ui",
    body: "The registry, the token rules and the review checklist, taught to your agent once.",
  },
  {
    href: "/llms.txt",
    title: "llms.txt",
    code: "/llms.txt · /llms-full.txt",
    body: "Every page has a Markdown twin, and the whole site is one file an assistant can read.",
  },
] as const
---

<SiteLayout title={SITE.name} description={SITE.tagline} route={Astro.url.pathname}>
  <div class="home" data-home>
    <section class="hero">
      <a class="hero-eyebrow" href="/changelog">
        <span class="hero-eyebrow-tag">v{SITE.version}</span>
        <span>See what changed</span>
        <span aria-hidden="true">→</span>
      </a>
      <h1>Discord-inspired UI, copy-pasted into your project.</h1>
      <p class="hero-lead">
        {COMPONENTS.length} components for bots, dashboards and community tools that should
        look at home beside a chat client. Each one ships as a React file, a Vue single file
        component and plain HTML and CSS, all reading one set of tokens.
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="/docs/installation">Get started</a>
        <a class="button-secondary" href="/docs/components">Browse components</a>
        <a class="button-secondary" href={SITE.github} target="_blank" rel="noreferrer">
          GitHub
        </a>
      </div>
      <dl class="hero-stats">
        {
          STATS.map((stat) => (
            <div>
              <dd>{stat.value}</dd>
              <dt>{stat.label}</dt>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="home-wall" aria-labelledby="wall-title">
      <div class="home-wall-bar">
        <div>
          <h2 id="wall-title">Every tile is a component</h2>
          <p>
            Pick a brand colour: one token changes and every tile follows. That is the whole
            theming model.
          </p>
        </div>
        <div class="brand-switch" role="group" aria-label="Brand colour">
          {
            BRANDS.map((brand, index) => (
              <button
                type="button"
                data-brand={brand.value}
                aria-pressed={index === 0 ? "true" : "false"}
                style={brand.value ? `--swatch:${brand.value}` : undefined}
              >
                <span class="brand-switch-dot" aria-hidden="true" />
                {brand.name}
              </button>
            ))
          }
          <a href="/create">Build a preset →</a>
        </div>
      </div>
      <ul class="wall">
        {
          WALL.map((component) => (
            <li class="wall-tile">
              <ComponentThumb name={component.name} fit="natural" />
              <a href={`/docs/components/${component.name}`}>{component.title}</a>
            </li>
          ))
        }
      </ul>
      <p class="home-wall-more">
        <a class="button-secondary" href="/docs/components">
          See all {COMPONENTS.length} components
        </a>
      </p>
    </section>

    <section class="home-section" id="install">
      <div class="home-split">
        <div>
          <h2>One command to start</h2>
          <p>
            One CLI for both frameworks. It reads your project during <code>init</code>, then
            writes component source into it. There is no package between you and the markup.
          </p>
          <PmTabs cmd="newtui@latest init" />
          <PmTabs cmd="newtui@latest add message-group poll" />
        </div>
        <div>
          <h2>Wherever you build</h2>
          <p>Step-by-step guides for each setup, including plain HTML and CSS.</p>
          <FrameworkGrid />
        </div>
      </div>
    </section>

    <section class="home-section" id="principles">
      <h2>What it is</h2>
      <CardGroup cols={3}>
        {
          PRINCIPLES.map((principle) => (
            <Card icon={principle.icon} title={principle.title}>
              {principle.body}
            </Card>
          ))
        }
      </CardGroup>
    </section>

    <section class="home-section" id="agents">
      <h2>Written for agents too</h2>
      <p>
        Most components are now placed by an assistant. The documentation is published in the
        forms an assistant reads, so it works from the real API and not from a guess.
      </p>
      <ul class="agent-grid">
        {
          AGENTS.map((agent) => (
            <li>
              <a href={agent.href}>
                <span class="agent-title">{agent.title}</span>
                <code>{agent.code}</code>
                <span class="agent-body">{agent.body}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="home-section home-next">
      <a href="/blocks">
        <span class="home-next-kicker">Blocks</span>
        <span class="home-next-title">Whole views, already assembled</span>
        <span class="home-next-body">
          A chat window, a server sidebar and a command panel, built from the registry.
        </span>
      </a>
      <a href="/create">
        <span class="home-next-kicker">Create</span>
        <span class="home-next-title">Your brand, radius and font in one code</span>
        <span class="home-next-body">
          Six choices become a preset you paste into <code>init</code>.
        </span>
      </a>
      <a href="/typeset">
        <span class="home-next-kicker">Typeset</span>
        <span class="home-next-title">Chat-style prose for long text</span>
        <span class="home-next-body">
          Headings, lists, quotes and code set the way a message renders them.
        </span>
      </a>
    </section>
  </div>
</SiteLayout>

<script>
  /*
   * The brand switch sets one custom property on the page's root element and
   * nothing else. Hover and active shades are derived from it in `theme.css`,
   * the same way `/create` derives them for a real preset. Delegated, so it
   * survives Blume's client router swapping the page in.
   */
  document.addEventListener("click", (event) => {
    const button =
      event.target instanceof Element
        ? event.target.closest<HTMLButtonElement>(".brand-switch [data-brand]")
        : null
    const home = button?.closest<HTMLElement>("[data-home]")
    if (!button || !home) return
    const value = button.dataset.brand ?? ""
    if (value === "") {
      home.style.removeProperty("--newt-brand")
      delete home.dataset.branded
    } else {
      home.style.setProperty("--newt-brand", value)
      home.dataset.branded = ""
    }
    for (const other of home.querySelectorAll(".brand-switch [data-brand]")) {
      other.setAttribute("aria-pressed", String(other === button))
    }
  })
</script>
