{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Matches the wolfstar-project convention: the registry ships intentionally
  // unused public exports (every component is a copy-paste target), so export
  // level reporting is off and only files/dependencies are enforced.
  "rules": {
    "exports": "off",
    "types": "off",
    "enumMembers": "off",
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,ts}"],
      "project": ["scripts/**/*.{mjs,ts}"],
    },
    "apps/docs": {
      // Astro's own plugin finds the pages, the layouts and the integrations;
      // these are the entry points it cannot see: the build scripts, the remark
      // plugin the Astro config loads, and the islands MDX mounts by name.
      "entry": [
        "astro.config.ts",
        "ec.config.mjs",
        "scripts/*.mjs",
        "src/content.config.ts",
        "src/components/**/*.{ts,tsx,vue,astro}",
        // Registry demos are copied in with their imports intact, so this file
        // is reached from outside the workspace knip walks.
        "src/lib/utils.ts",
        "src/pages/**/*.{ts,astro}",
        // The layout loads this one through `<script src="/src/pwa.ts">`,
        // which is a string as far as any static walk is concerned.
        "src/pwa.ts",
        // The theme reads this one off a path in `head`, so nothing imports
        // it. It is where `tw-animate-css` and the registry sources come in.
        "src/styles/lotus.css",
      ],
      // `.css` is in `project` so knip follows `src/styles/site.css`, which is
      // where `tailwindcss` and `tw-animate-css` are imported from.
      "project": [
        "src/**/*.{ts,tsx,vue,astro,css}",
        "scripts/**/*.mjs",
        "*.{ts,mjs}",
      ],
      // Indirections nothing static can follow: the Open Graph renderer asks
      // for a font file by name through `require.resolve`; the PWA virtual
      // modules are typed by a triple-slash reference to a package
      // `@vite-pwa/astro` brings in itself; and the three Iconify collections
      // are looked up by package name at build time by the theme's icon
      // middleware, which otherwise reaches for `api.iconify.design` and makes
      // the build need a network.
      "ignoreDependencies": [
        "@fontsource/inter",
        "vite-plugin-pwa",
        "@iconify-json/lucide",
        "@iconify-json/simple-icons",
        "@iconify-json/vscode-icons",
      ],
    },
    "apps/www": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "registry/index.ts",
        "registry/bases/newt/**/*.{ts,tsx}",
        "scripts/build-registry.mts",
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignore": ["__registry__/**"],
    },
    "apps/vue": {
      "entry": [
        "app/app.vue",
        "registry/index.ts",
        "registry/bases/newt/**/*.{ts,vue}",
        // Nuxt auto-imports this directory; nothing imports it explicitly.
        "app/utils/**/*.ts",
        "scripts/build-registry.mts",
      ],
      "project": [
        "app/**/*.{ts,vue}",
        "registry/**/*.{ts,vue}",
        "nuxt.config.ts",
      ],
      "ignore": ["__registry__/**"],
      "ignoreDependencies": ["vue-router"],
    },
    "packages/cli": {
      "entry": ["src/index.ts", "cli/index.js"],
      "project": ["src/**/*.ts"],
    },
    // The two scoped packages are deprecation wrappers around `newtui`; their
    // only source is the bin that forwards to it.
    "deprecated/react-cli": {
      "entry": ["bin/*.js"],
      "project": ["bin/*.js"],
    },
    "deprecated/vue-cli": {
      "entry": ["bin/*.js"],
      "project": ["bin/*.js"],
    },
    "packages/module": {
      "entry": ["src/module.ts"],
      "project": ["src/**/*.ts"],
      // `@nuxt/schema` only shows up in the generated `dist/module.d.mts`, which
      // knip does not scan; `nuxt` is a dev-time peer of the module builder.
      "ignoreDependencies": ["@nuxt/schema", "nuxt"],
    },
    "templates/next-template": {
      "entry": ["app/**/*.{ts,tsx}", "lib/utils.ts"],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["class-variance-authority", "lucide-react"],
    },
    "templates/nuxt-template": {
      "entry": ["app/pages/**/*.vue", "app/lib/utils.ts", "app/app.vue"],
      "project": ["app/**/*.{ts,vue}", "nuxt.config.ts"],
      "ignoreDependencies": [
        "class-variance-authority",
        "lucide-vue-next",
        "vue",
      ],
    },
  },
}
