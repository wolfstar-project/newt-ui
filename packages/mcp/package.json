{
  "name": "@newtui/mcp",
  "version": "0.1.0",
  "description": "MCP server for the newt/ui documentation — lets a coding agent list, search and read the Discord-inspired component library's docs. Part of the WolfStar toolchain.",
  "keywords": [
    "component-library",
    "design-system",
    "discord",
    "documentation",
    "mcp",
    "model-context-protocol",
    "ui",
    "wolfstar"
  ],
  "homepage": "https://newtui.dev/docs/mcp",
  "bugs": {
    "url": "https://github.com/wolfstar-project/newt-ui/issues"
  },
  "license": "Apache-2.0",
  "author": "@wolfstar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfstar-project/newt-ui.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "newtui-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --config-loader unrun --watch",
    "prepack": "pnpm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.2",
    "unrun": "^0.3.1",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
