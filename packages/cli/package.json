{
  "name": "newtui",
  "version": "2.2.0",
  "description": "CLI for newt/ui — Discord-native UI components for React, Vue and Nuxt (shadcn-style registry). Part of the WolfStar toolchain.",
  "keywords": [
    "component-library",
    "design-system",
    "discord",
    "discord-bot",
    "nuxt",
    "react",
    "shadcn",
    "ui",
    "vue",
    "wolfstar"
  ],
  "homepage": "https://newtui.dev",
  "bugs": {
    "url": "https://github.com/wolfstar-project/newt-ui/issues"
  },
  "license": "Apache-2.0",
  "author": "@wolfstar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfstar-project/newt-ui.git",
    "directory": "packages/cli"
  },
  "bin": {
    "newtui": "./dist/index.js",
    "newtui-html": "./cli/index.js"
  },
  "files": [
    "dist",
    "cli",
    "registry",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "dev": "tsdown --config-loader unrun --watch",
    "prepack": "pnpm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cross-spawn": "^7.0.6",
    "mri": "^1.2.0",
    "package-manager-detector": "^1.8.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.2",
    "unrun": "^0.3.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
