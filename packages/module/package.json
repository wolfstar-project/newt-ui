{
  "name": "@wolfstar/nuxt-newt-ui",
  "version": "0.3.0",
  "description": "Nuxt module for newt/ui — auto-imports your Discord-native newt/ui components and injects the --newt-* design tokens.",
  "keywords": [
    "design-system",
    "discord",
    "nuxt",
    "nuxt-module",
    "ui",
    "vue",
    "wolfstar"
  ],
  "homepage": "https://newtui.dev",
  "bugs": {
    "url": "https://github.com/wolfstar-project/newt-ui/issues"
  },
  "license": "Apache-2.0",
  "author": "@wolfstar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfstar-project/newt-ui.git",
    "directory": "packages/module"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build build --stub",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "lint:fix": "oxlint -c ../../.oxlintrc.json --fix .",
    "prepack": "nuxt-module-build build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^22.10.2",
    "nuxt": "^4.5.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
