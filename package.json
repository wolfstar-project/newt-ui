{
  "name": "newt-ui-monorepo",
  "private": true,
  "description": "Monorepo for newt/ui — Discord-native UI components (React, Vue, HTML/CSS) and CLI. Part of the WolfStar toolchain.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "dev": "turbo run dev --parallel",
    "format": "oxfmt -c tooling/oxc/.oxfmtrc.json --ignore-path .oxfmtignore .",
    "format:check": "oxfmt -c tooling/oxc/.oxfmtrc.json --ignore-path .oxfmtignore --check .",
    "knip": "knip",
    "lint": "pnpm --filter docs exec astro sync && oxlint .",
    "lint:ci": "turbo run //#lint //#format:check",
    "lint:fix": "pnpm --filter docs exec astro sync && oxlint --fix .",
    "prepare": "node .husky/install.mjs && skilld prepare --agent claude-code",
    "publish": "turbo run build --filter=./packages/* --filter=./deprecated/* && changeset publish",
    "publish:snapshot": "node scripts/publish-snapshot.mjs",
    "quality": "turbo run //#lint //#format:check",
    "quality:fix": "turbo run //#lint:fix //#format",
    "registry:build": "turbo run registry:build",
    "skills:add": "skilld add --agent claude-code",
    "skills:install": "skilld install --agent claude-code",
    "skills:list": "skilld list",
    "skills:update": "skilld update --agent claude-code",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@oxlint/plugins": "^1.79.0",
    "husky": "^9.1.7",
    "knip": "^6.2.4",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "skilld": "^2.3.0",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3"
  },
  "nano-staged": {
    "*.{ts,mts,cts,tsx,vue,mjs,cjs,js,jsx,json,jsonc,yml,yaml,md,mdx,css}": "oxfmt -c tooling/oxc/.oxfmtrc.json --ignore-path .oxfmtignore --no-error-on-unmatched-pattern",
    "*.{ts,mts,cts,tsx,vue,mjs,cjs,js,jsx}": "oxlint -c .oxlintrc.json --fix --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.11"
  },
  "packageManager": "pnpm@11.22.0"
}
